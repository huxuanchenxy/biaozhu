# ===========================================
# 通用配置：所有环境都会加载
# 同名变量会被 .env.development / .env.production 覆盖
# 注意：只有 VITE_ 开头的变量才会暴露给前端代码
# ===========================================

# 应用标题
VITE_APP_TITLE = 标注平台

# 接口基础路径（业务接口统一前缀）
VITE_APP_BASE_API = /api

# 路由模式：hash（URL 带 #，部署免配置）| history（URL 干净，需服务端配合）
VITE_ROUTER_MODE = hash

# 待标注文档地址：现在指向 public/doc 下的本地文件，后续换成后端接口时改这里即可
VITE_APP_DOC_URL = /doc/BE1020801A3.md
