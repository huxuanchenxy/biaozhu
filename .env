# ===========================================
# 通用配置：所有环境都会加载
# 同名变量会被 .env.development / .env.production 覆盖
# 注意：只有 VITE_ 开头的变量才会暴露给前端代码
# ===========================================

# 应用标题
VITE_APP_TITLE = 标注平台

# 接口基础路径（业务接口统一前缀）
VITE_APP_BASE_API = /api

# 路由模式：hash（URL 带 #，部署免配置）| history（URL 干净，需服务端配合）
VITE_ROUTER_MODE = hash

# 后端服务地址（仅生产 server.mjs 反代 /api 用；开发由 Vite 代理 VITE_PROXY_TARGET）
API_TARGET = http://10.89.33.97:8080

# 后端文件接口直连基址（含 /api）：md/json 下载(/file/download) 与保存(/file/uploadOverwrite) 都直连，不走代理（需后端允许 CORS）
VITE_API_DIRECT_BASE = http://10.89.33.97:8080/api

# 待标注文档地址：现在指向 public/doc 下的本地文件，后续换成后端接口时改这里即可
VITE_APP_DOC_URL = /doc/BE1020801A3.md

# ---------- Dify 翻译 workflow ----------
# 页面读取 md 文档后即自动整篇提交翻译（blocking 模式），不再使用本地模型
# Dify 应用 API Key（workflow 类型）
VITE_DIFY_API_KEY = app-q0f9aAfNCWLt87scjdjMckmd
# Dify 服务地址：前端直接调用（不走代理），需 Dify 侧允许跨域（CORS）
VITE_DIFY_API_BASE = http://10.89.33.93
# 调用 Dify 时携带的用户标识
VITE_DIFY_USER = huyz
# workflow 开始节点的输入变量名：md 原文以字符串放入 inputs[input]
VITE_DIFY_INPUT_KEY = userinput

# ---------- MinIO 对象存储 ----------
# 以下 MINIO_* 不带 VITE_ 前缀：仅服务端 server.mjs 读取，不会打进前端包（密钥不暴露）
# MinIO 服务地址
MINIO_ENDPOINT = http://10.89.14.234:12001
# 访问密钥（Access Key）
MINIO_ACCESS_KEY = NXKKBDFEZP9XNNHVRIHT
# 私密密钥（Secret Key）
MINIO_SECRET_KEY = Fx0k0Ix2Pab4hkZMOvl3oLLKL08W5ZPVmBiTyJUS
# 存储桶名称（带 VITE_ 前缀：前端需要它拼 fullObjectPath 前缀 /<bucket>/<key>）
VITE_MINIO_BUCKET = drivdernet_abc

# ---------- 标注 json 路径规则 ----------
# 由 md 推导三个标注 json 的相对路径模板：相对 md 上级目录（与 QA/SFT/CoT 同级），{name}=md 主名（去 .md）
# 后缀（如 _sft.json）或文件夹名变动时改这里即可，无需改代码
VITE_ANNOTATION_QA_PATTERN = QA/{name}_qa.json
VITE_ANNOTATION_SFT_PATTERN = SFT/{name}_alpaca.json
VITE_ANNOTATION_COT_PATTERN = CoT/{name}_cot.json

# 原始 PDF 路径规则：PDF 与装 MD 的目录 <parent> 同级（在 <parent> 的上级目录下），{name}=md 主名（去 .md）
# 例：.../成品语料/<id>/MD/<id>.md -> .../成品语料/<id>.pdf
VITE_DOC_PDF_PATTERN = {name}.pdf
