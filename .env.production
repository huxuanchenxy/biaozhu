# ===========================================
# 生产环境：npm run build
# ===========================================

# 环境标识
VITE_APP_ENV = production

# 接口基础路径
# 默认保持 /api，由 Nginx 反向代理到后端；
# 若前后端不同域且后端已开 CORS，可直接写完整地址：http://10.89.34.77:8080/api
VITE_APP_BASE_API = /api

# 打包输出目录
VITE_OUT_DIR = dist


# 是否默认自动加载本地翻译模型（NLLB-200，约 600MB，加载后占用较多浏览器内存）
#   true  = 打开页面即后台预热模型，切到「翻译」页无需等待（吃内存）
#   false = 不自动加载，进入「翻译」页后点按钮才加载（默认，省内存）
VITE_APP_TRANSLATION_AUTOLOAD = false
