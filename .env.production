# 若前后端不同域且后端已开 CORS，可直接写完整地址：http://10.89.34.77:8080/api
VITE_APP_BASE_API = /api

# 打包输出目录
VITE_OUT_DIR = dist


# ---------- Dify 翻译 workflow ----------
