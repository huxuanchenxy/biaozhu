# ===========================================
# 生产环境：npm run build
# ===========================================

# 环境标识
VITE_APP_ENV = production

# 接口基础路径
# 默认保持 /api，由 Nginx 反向代理到后端；
# 若前后端不同域且后端已开 CORS，可直接写完整地址：http://10.89.34.77:8080/api
VITE_APP_BASE_API = /api

# 打包输出目录
VITE_OUT_DIR = dist

# ---------- 生产服务器（server.mjs）----------
# server.mjs 监听端口；仅 server.mjs 读取，不带 VITE_ 前缀故不会打进前端包
SERVER_PORT = 3344
# 后端服务地址：生产 server.mjs 把 /api/... 反代到它（保存 json 的 uploadOverwrite）
API_TARGET = http://10.89.34.77:8080


# ---------- Dify 翻译 workflow ----------
VITE_DIFY_API_KEY = app-q0f9aAfNCWLt87scjdjMckmd
# 前端直接调用 Dify（不走代理），需 Dify 侧允许跨域（CORS）
VITE_DIFY_API_BASE = http://10.89.33.93
VITE_DIFY_USER = huyz
VITE_DIFY_INPUT_KEY = userinput

# ---------- MinIO 对象存储 ----------
# 密钥/地址仅服务端 server.mjs 使用，不带 VITE_ 前缀（不进前端包）；
# build 会随 .env.production 拷进 dist 供 server.mjs 运行时读取
MINIO_ENDPOINT = http://10.89.14.234:12001
MINIO_ACCESS_KEY = NXKKBDFEZP9XNNHVRIHT
MINIO_SECRET_KEY = Fx0k0Ix2Pab4hkZMOvl3oLLKL08W5ZPVmBiTyJUS
VITE_MINIO_BUCKET = drivdernet_abc
