node_modules
dist
dist-ssr
.DS_Store
*.local

# 日志
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 构建缓存
*.tsbuildinfo

# 编辑器
.vscode/*
!.vscode/extensions.json
.idea

# 本地环境变量（含密钥的放这里，不要提交）
.env.local
.env.*.local

# 自托管的翻译模型与 wasm 运行时（体积大，由 `npm run fetch:model` 生成，不入库）
public/models
public/wasm
/src/workers/*.pdf
# pdf_download.py 批量下载的语料 PDF（体积大，不入库）
/src/workers/pdf/
# 校验脚本的回归样本与人工点验件（都是语料原件的副本，不入库）
/src/workers/_libtest/
# Python 字节码缓存（脚本被 import 时自动生成，无用可删）
__pycache__/
