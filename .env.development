# ===========================================
# 开发环境：npm run dev
# ===========================================

# 环境标识
VITE_APP_ENV = development

# 开发服务器端口
VITE_PORT = 3000

# 接口基础路径（前端请求前缀，会被 Vite 代理转发）
VITE_APP_BASE_API = /api

# 后端真实服务地址（仅用于 dev 代理，浏览器请求仍走 /api，不产生跨域）
VITE_PROXY_TARGET = http://10.89.34.77:8080

# 是否默认自动加载本地翻译模型（NLLB-200，约 600MB，加载后占用较多浏览器内存）
#   true  = 打开页面即后台预热模型，切到「翻译」页无需等待（吃内存）
#   false = 不自动加载，进入「翻译」页后点按钮才加载（默认，省内存）
VITE_APP_TRANSLATION_AUTOLOAD = false

