# 环境标识
VITE_APP_ENV = development

# 开发服务器端口
VITE_PORT = 3000

# 接口基础路径（前端请求前缀，会被 Vite 代理转发）
VITE_APP_BASE_API = /api

# 后端真实服务地址（仅用于 dev 代理，浏览器请求仍走 /api，不产生跨域）
VITE_PROXY_TARGET = http://10.89.33.97:8080

# ---------- Dify 翻译 workflow ----------
VITE_DIFY_API_KEY = app-q0f9aAfNCWLt87scjdjMckmd
# 前端直接调用 Dify（不走代理），需 Dify 侧允许跨域（CORS）
VITE_DIFY_API_BASE = http://10.89.33.93
VITE_DIFY_USER = huyz
VITE_DIFY_INPUT_KEY = userinput

